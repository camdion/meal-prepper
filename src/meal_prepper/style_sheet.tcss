MyApp #main_menu_buttons_container {
    align: center middle;
}

MyApp Button {
    width: 40;
    margin: 2;
    padding: 1 2;
}

MyApp Button:focus-within {
    border: heavy;
}

SearchFood Input {
    dock: top;
}

SearchInput Input {
    width: 60;
}

Search #search_query {
    height: 5;
}

Search #search_input_container {
    width: 3fr;
}
Search Label {
    margin-left: 1;
}
Search #use_branded_container {
    width: auto;
}

Search #use_branded {
    max-width: 10;
}

Search #search_results {
    height: 1fr;
}

Search #bottom_search_pane {
    dock: bottom;
    height: auto;
}

Favorites #bottom_favorites_pane {
    dock: bottom;
    height: auto;
}

Favorites #favorites_table {
    height: 1fr;
}

#bottom_pane {
    dock: bottom;
    height: auto;
}

MealOptions {
    height: 3;
}

MealOptions Placeholder {
    width: 1fr;
    height: 100%;
}

MealOptions Button {
    width: 1fr;
    margin: 0;
    height: 100%;
    padding: 0;
}

EditMealScreen #edit_meal_screen_display_totals {
    dock: top;
    height: 3;
}

EditMealScreen #edit_meal_screen_display_totals Placeholder {
    width: 1fr;
    height: 100%;
}

EditMealScreen VerticalScroll {
    height: 1fr;
}

EditMealScreen EMMealIngredient {
    height: 3;
    width: 1fr;
}

EditMealScreen EMMealIngredient Button {
    padding: 0;
    margin: 0;
}

EditMealScreen VerticalScroll Button {
    width: 1fr;
    height: 3;
}
EditMealScreen VerticalScroll Placeholder {
    width: 1fr;
    height: 3;
}

EditMealScreen #edit_meal_screen_add_ing {
    width: 40;
    height: auto;
}

EnterAmount {
    align: center middle;
}

EnterAmount Vertical {
    align: center middle;
}

EnterAmount Horizontal {
    align: center middle;
}

EnterAmount Input {
    width: 50%;
}

EnterAmount Placeholder {
    width: 1fr;
    height: 5;
