MyApp #main_menu_buttons_container {
    align: center middle;
}

MyApp Button {
    width: 40;
    margin: 2;
    padding: 1 2;
}
MyApp Button:focus-within {
    border: heavy;
}

SearchFood Input {
    dock: top;
}

Meals Button {
    height: 4;
    padding: 0;
    margin: 1;
    width: 1fr;
}

MealContainer ListItem {
    layout: horizontal;
}

Ribbon {
    width: 1fr;
    layout: horizontal;
}

Favorites ListItem {
    layout: horizontal;
}

SearchInput Input {
    width: 60;
}

Search #search_query {
    height: 5;
}

Search #search_input_container {
    width: 3fr;
}
Search Label {
    margin-left: 1;
}
Search #use_branded_container {
    width: auto;
}

Search #use_branded {
    max-width: 10;
}

Search #search_results {
    height: 1fr;
}

Search #bottom_search_pane {
    dock: bottom;
    height: auto;
}

Favorites #bottom_favorites_pane {
    dock: bottom;
    height: auto;
}

Favorites #favorites_table {
    height: 1fr;
}
